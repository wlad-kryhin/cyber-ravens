# Jira (server-side only — never commit real values)
JIRA_BASE_URL=https://talentechgroup.atlassian.net
JIRA_EMAIL=your.email@talentech.com
JIRA_API_TOKEN=

# Optional: Cursor builds the Jira search from the user's question.
# Create a key at https://cursor.com/dashboard/integrations
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5

# Optional fallback if Cursor is not configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Confluence uses the same Atlassian site and API token as Jira.
# Optional: limit search to one space key.
# CONFLUENCE_SPACE_KEY=ENGINEERING
# CONFLUENCE_BASE_URL=https://talentechgroup.atlassian.net

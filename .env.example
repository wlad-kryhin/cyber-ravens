# Jira (server-side only — never commit real values)
JIRA_BASE_URL=https://talentechgroup.atlassian.net
JIRA_EMAIL=your.email@talentech.com
JIRA_API_TOKEN=

# Optional: used to break down questions and formulate answers.
# Without this key the app still searches Jira and drafts a fallback answer.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
